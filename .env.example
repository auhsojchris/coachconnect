# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=5001
API_PREFIX=/api
CLIENT_URL=http://localhost:3000

# ==============================
# Database (MySQL)
# ==============================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coach_booking_dev
DB_USER=root
DB_PASSWORD=changeme
DB_DIALECT=mysql

# ==============================
# JWT
# ==============================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_RESET_SECRET=replace_with_a_different_long_random_string
JWT_RESET_EXPIRES_IN=15m

# ==============================
# Bcrypt
# ==============================
BCRYPT_SALT_ROUNDS=12

# ==============================
# Rate Limiting
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ==============================
# Stripe
# ==============================
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# ==============================
# GCash
# ==============================
# Stripe doesn't process GCash directly. Platform commission rate applied to
# every GCash booking, e.g. 0.10 = 10%.
PLATFORM_FEE_RATE=0.10

# Automatic GCash checkout via PayMongo: client pays straight into the
# platform's PayMongo balance (like Stripe), confirmed by webhook. Get real
# keys from dashboard.paymongo.com/developers.
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me

# Manual fallback used when PayMongo isn't configured: each coach sets their
# own GCash number in their profile, clients send them the money directly and
# submit the reference number, and the coach confirms receipt from their
# dashboard. The commission is recorded as an amount the coach owes.

# ==============================
# Email (Nodemailer / SMTP)
# ==============================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
EMAIL_FROM=Coach Booking <no-reply@coachbooking.com>

# ==============================
# File Uploads
# ==============================
MAX_FILE_UPLOAD_MB=5
UPLOAD_PATH=uploads/coaches

# ==============================
# Admin bootstrap
# ==============================
# Registration only allows the 'coach' or 'client' role; the 'admin' seeder
# (npm run seed) creates exactly one admin account from these credentials so
# there's always a way into /admin/*. Change the password after first login.
ADMIN_EMAIL=admin@coachconnect.dev
ADMIN_PASSWORD=ChangeMe123!
