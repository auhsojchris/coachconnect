# Base URL for the backend API. Leave as /api to use the Vite dev proxy
# (see vite.config.ts) which forwards to http://localhost:5000.
VITE_API_URL=/api

# Stripe publishable (public) key — safe to expose in frontend code.
# Get this from the Stripe Dashboard > Developers > API keys (use the test key
# while developing). Must correspond to the STRIPE_SECRET_KEY set in the
# backend's .env for PaymentIntents to work.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
